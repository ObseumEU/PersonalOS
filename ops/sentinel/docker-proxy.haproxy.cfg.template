# The sentinel's Docker API (tecnativa/docker-socket-proxy v0.5.0 with this template mounted over its own,
# docker-compose.yml service docker-proxy). The stock rules cannot do what the sentinel needs: with POST=0 every
# POST is denied before ALLOW_RESTARTS is even looked at (prod 2026-09-30: the runbook's restart of litellm got
# "403 Forbidden"), and POST=1 would open /containers/create and /containers/{id}/exec, i.e. the host.
#
# Allowed here, nothing else:
#   GET  /containers/json, /containers/{name}/json, /containers/{name}/logs   (state and logs)
#   POST /containers/{name}/restart  for the runbook's stateless allowlist (sentinel/config.py runbook.restart_allowlist)
#   POST /containers/{name}/start    for personalos-deployer-1 (runbook.start_allowlist)
# A new container on either allowlist must be added here too (the proxy has the last word).
global
    log stdout format raw daemon "${LOG_LEVEL}"

    pidfile /run/haproxy.pid
    maxconn 4000

    # Turn on stats unix socket
    server-state-file /var/lib/haproxy/server-state

defaults
    mode http
    log global
    option httplog
    option dontlognull
    option http-server-close
    option redispatch
    retries 3
    timeout http-request 10s
    timeout queue 1m
    timeout connect 10s
    timeout client 10m
    timeout server 10m
    timeout http-keep-alive 10s
    timeout check 10s
    maxconn 3000

    # Allow seamless reloads
    load-server-state-from-file global

    # Use provided example error pages
    errorfile 400 /usr/local/etc/haproxy/errors/400.http
    errorfile 403 /usr/local/etc/haproxy/errors/403.http
    errorfile 408 /usr/local/etc/haproxy/errors/408.http
    errorfile 500 /usr/local/etc/haproxy/errors/500.http
    errorfile 502 /usr/local/etc/haproxy/errors/502.http
    errorfile 503 /usr/local/etc/haproxy/errors/503.http
    errorfile 504 /usr/local/etc/haproxy/errors/504.http

backend dockerbackend
    server dockersocket $SOCKET_PATH

frontend dockerfrontend
    bind ${BIND_CONFIG}

    acl restart_ok path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/(personalos-api-1|personalos-web-1|nexus-process-pilot-web-1|nexus-process-pilot-api-1|kb-web-1|litellm|langfuse-web)/restart$
    acl start_ok path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/(personalos-deployer-1)/start$
    acl read_ok path,url_dec -m reg -i ^(/v[\d\.]+)?/containers/(json|[a-zA-Z0-9_.-]+/(json|logs))$

    http-request allow if METH_POST restart_ok
    http-request allow if METH_POST start_ok
    http-request allow if METH_GET read_ok
    http-request deny
    default_backend dockerbackend
