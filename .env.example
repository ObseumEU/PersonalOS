# Copy to .env and fill in. Leave POS_PASSWORD empty only for local dev (no login).
POS_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POS_SESSION_SECRET=
# Host port for the web UI.
POS_PORT=8080
# Bearer key for MCP clients acting as the owner (Codex / Claude on the laptop).
# Generate with: python -c "import secrets; print('pos_' + secrets.token_urlsafe(32))"
POS_MCP_TOKEN=
# Agent workers (docker compose --profile agents): keys from each agent's page (New key).
DEV_AGENT_KEY=
MAIL_AGENT_KEY=
COMMUNITY_AGENT_KEY=
# Asistent vedení (Chief of Staff); empty: the key the core writes to data/worker-keys/asistent-vedeni.
COS_AGENT_KEY=
# Folder with a logged-in Codex CLI, mounted into the workers (e.g. C:/Users/you/.codex).
CODEX_HOME_HOST=
# Agent runtimes (auto|codex|claude). auto tries POS_ENGINE_ORDER: Codex first, Claude as fallback.
POS_AGENT_RUNTIME=auto
POS_ENGINE_ORDER=codex,claude
# Models: shown on each agent and recorded on every run (the CLI's own report wins).
POS_CODEX_MODEL=gpt-5.6-sol
POS_CLAUDE_MODEL=claude-opus-5-5
# Claude subscription login for containers: run `claude setup-token` once and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Calendars as private iCal feeds (secret URLs), space separated, optionally Name|url
POS_CALENDAR_ICS=

# Machine clients that may POST /api/events (name:token, comma separated), e.g. knowlage new mail
POS_EVENTS_TOKENS=

# Weekly report and meeting (Asistent vedení, pos.weekly). The time is also editable on Automations.
POS_WEEKLY_REPORT_SCHEDULE=weekly fri 14:00
# Links in chat to the report page (e.g. https://pos.example.com); empty: in-app links.
POS_PUBLIC_URL=
# Commits per repository for the report: a GitHub token that can read the org (also used for outbound GitHub).
POS_GITHUB_TOKEN=
# Which repositories: a list (owner/name, comma separated), else every repo of the org pushed that week.
POS_REPORT_REPOS=
POS_REPORT_GITHUB_ORG=ObseumEU
# Communication counts from knowlage: on when POS_KNOWLAGE_API_KEY is set; 0 turns it off, 1 forces it.
POS_REPORT_KNOWLAGE=
# knowlage service key: a knowlage agent key for PersonalOS (an entry of knowlage's KB_AGENT_KEYS). The
# server uses it for the file push, file search, the agents' `knowledge` tool and the report's invoices;
# it never reaches a model. Without it all of these are off.
POS_KNOWLAGE_API_KEY=
# GitHub triage: new issues and PRs of this organisation's repositories go to the CTO (every 30 min,
# needs POS_GITHUB_TOKEN); default POS_REPORT_GITHUB_ORG, else ObseumEU.
POS_TRIAGE_GITHUB_ORG=

# The sentinel (ops/sentinel, docs/SENTINEL.md): one shared token for its events, heartbeat and log API
# (PersonalOS accepts it as the event sender "sentinel"). Start it with `--profile sentinel`.
POS_SENTINEL_TOKEN=
# Nexus run numbers: a read-only Postgres role (SELECT on runs, workflow_runs, run_events).
SENTINEL_NEXUS_DSN=
# LiteLLM spend vs budgets: a viewer key (never the master key); empty = skipped.
SENTINEL_LITELLM_KEY=
# 1 enables POST /api/test/inject for the end-to-end check; keep 0.
SENTINEL_TEST_HOOK=0
# Caps for the Monitor agent (pos.monitor); above them incidents reach the owner as text.
POS_MONITOR_MAX_INCIDENTS_DAY=12
POS_MONITOR_MAX_RUNS_INCIDENT=2

# Credentials for agents from 1Password (pos.credentials, docs/CREDENTIALS.md): a service account token with
# read access to one vault. Both empty = the feature is off and every credential use fails closed.
OP_SERVICE_ACCOUNT_TOKEN=
POS_OP_VAULT=PersonalOS Agents

# Web Push for the installed app (/m, docs/MOBILE.md): a VAPID key pair (base64url), generated once on the
# server with pos.push.generate_vapid (never printed). Both empty: notifications are off.
POS_VAPID_PRIVATE_KEY=
POS_VAPID_PUBLIC_KEY=
POS_VAPID_SUBJECT=mailto:admin@obseum.cz

# ---------------------------------------------------------------------------------------------------------
# Optional settings. Each line is commented out on purpose: an empty value is not the same as unset for
# several of them (an empty URL would replace the built-in default). Uncomment and fill in only what you
# change; the default is described in the module named in brackets.

# Server basics (pos.config): data folder (default data); HTTPS-only session cookie (1 on the server);
# the in-app scheduler of system jobs (default on); upload and agent-file limits in MB.
# POS_DATA_DIR=
# POS_SECURE_COOKIES=
# POS_SCHEDULER=
# POS_MAX_UPLOAD_MB=
# POS_AGENT_FILE_MAX_MB=
# POS_AGENT_FILES_QUOTA_MB=
# Key for secrets PersonalOS stores encrypted (the LinkedIn token, pos.outbound_linkedin); empty: derived
# from POS_SESSION_SECRET. Generate like the session secret; changing it makes stored tokens unreadable.
# POS_SECRETS_KEY=
# Key for the agents' browser profiles (pos.browser); empty: derived from the session secret.
# POS_BROWSER_PROFILE_KEY=
# Extra domains where the agents' browser asks the owner before acting (comma separated).
# POS_BROWSER_APPROVAL_DOMAINS=
# Prometheus scrape token for /metrics (pos.metrics); empty: only private-network requests.
# POS_METRICS_TOKEN=
# Working hours for the agenda (pos.agenda), e.g. 09:00-17:00.
# POS_WORK_HOURS=

# Agents and engines (pos.runner, pos.engines, pos.agents_code)
# Paths to the Codex / Claude CLIs (default: found on PATH); 1 disables an engine.
# POS_CODEX_BIN=
# POS_CLAUDE_BIN=
# POS_CODEX_DISABLED=
# POS_CLAUDE_DISABLED=
# 1: the server checks the Claude CLI itself.
# POS_CLAUDE_SELFCHECK=
# Agents defined as code in the repo (default on; 0 off) and where that repo and the tools are checked out.
# POS_AGENTS_AS_CODE=
# POS_AGENTS_REPO_DIR=
# POS_TOOLS_REPO_DIR=
# Folder with the agent pool's worker keys (pos.workers); empty: no automatic workers.
# POS_WORKER_KEYS_DIR=
# Default grants for every agent (pos.access; default on, 0 off).
# POS_AUTONOMY=
# Override of the agents' constitution file (pos.guard.prompt).
# POS_CONSTITUTION=
# Owner identities and the signing keys file for the git guard (pos.guard.gitcheck).
# POS_OWNER_PRINCIPALS=
# POS_OWNER_SIGNERS=
# The fast lane for quick owner messages (pos.fastlane; default on, 0 off) and its model.
# POS_FASTLANE=
# POS_FASTLANE_MODEL=
# Models for the owner report and the promise tracker.
# POS_OWNER_REPORT_MODEL=
# POS_OWNER_REPORT_EFFORT=
# POS_PROMISES_MODEL=
# Evidence checks on finished work (pos.evidence; 0 off) and the git repos they may read.
# POS_EVIDENCE_CHECKS=
# POS_EVIDENCE_REPOS=
# Grounded in reality (docs/REALITY.md): the claim gate on outbound and owner-facing content (0 off), its
# model, the network probes (0: no DNS/HTTP), our own domains (strict link checks, default obseum.cz), hours
# a live verification holds (default 72), and done-means-delivered on hand-ins (0 off).
# POS_GROUNDING=
# POS_GROUNDING_MODEL=
# POS_GROUNDING_NETWORK=
# POS_OWN_DOMAINS=
# POS_REALITY_EXPIRY_HOURS=
# Deployer status files (comma-separated) that say which commit runs on a test instance (probe_mode test,
# deploy_ref); default /agent-work/kniha/.deploy/status.txt.
# POS_DEPLOY_STATUS=
# POS_DELIVERY_GATE=

# Chat limits (pos.chat, pos.flood): longest agent message; loop, rate and one-way limits as count/seconds.
# POS_CHAT_AGENT_MAX=
# POS_CHAT_LOOP=
# POS_CHAT_RATE_LIMIT=
# POS_CHAT_ONEWAY=
# Meetings (pos.meetings): budget in USD, longest meeting and longest turn in minutes.
# POS_MEETING_BUDGET_USD=
# POS_MEETING_MAX_MINUTES=
# POS_MEETING_TURN_MINUTES=

# Budget (pos.budget): renewal day of month, optional token cap, the owner's reserved share, the Codex
# logs folder, minutes between checks (0 off).
# POS_BUDGET_RENEWAL_DAY=
# POS_BUDGET_MONTHLY_TOKENS=
# POS_BUDGET_OWNER_RESERVE=
# POS_BUDGET_CODEX_HOME=
# POS_BUDGET_CHECK_MINUTES=
# HR (pos.hr): run the daily review and weekly report in the app, the hour of the daily review and the
# weekday of the weekly one (0 = Monday).
# POS_HR_SCHEDULER=
# POS_HR_DAILY_HOUR=
# POS_HR_WEEKLY_DAY=

# Review and deploys (pos.deploy_review, pos.selfdeploy, pos.review_packet, pos.routing)
# Minutes a pending review holds the deployer before the work proceeds (default 30).
# POS_REVIEW_SLA_MIN=
# Daily USD cap for the reviews of agents' work (pos.review_work).
# POS_REVIEW_DAILY_USD=
# The UX smoke check after deploys (pos.improve.smoke; default on, 0 off) and the base URL it opens.
# POS_UX_SMOKE=
# POS_UX_SMOKE_URL=
# Repositories the review packet and the dev routing know (owner/name, comma separated).
# POS_REVIEW_REPOS=
# POS_DEV_REPOS=
# The deployer member's key and the PersonalOS URL it talks to.
# POS_DEPLOYER_KEY=
# POS_URL=
# Secret GitHub signs its webhooks with.
# POS_GITHUB_WEBHOOK_SECRET=
# Read-only token for the weekly report's commits when POS_GITHUB_TOKEN is not set.
# POS_REPORT_GITHUB_TOKEN=

# Outbound (pos.outbound)
# 1: everything is built and audited, nothing leaves.
# POS_OUTBOUND_DRY_RUN=
# Per agent and action per 24 h as JSON (e.g. an email.send count); overrides the built-in limits.
# POS_OUTBOUND_LIMITS=
# E-mail from agents: draft (Gmail drafts the owner sends) or auto; the setting on the web wins.
# POS_EMAIL_MODE=
# Discord webhook for discord.post.
# POS_DISCORD_WEBHOOK_URL=
# LinkedIn: the OAuth app (then "Připojit LinkedIn" in the app), or a fixed token and author URN instead.
# POS_LINKEDIN_CLIENT_ID=
# POS_LINKEDIN_CLIENT_SECRET=
# POS_LINKEDIN_ACCESS_TOKEN=
# POS_LINKEDIN_AUTHOR=
# POS_LINKEDIN_VERSION=

# Google (pos.invoices.gapi, pos.outbound_gmail): the OAuth client and refresh tokens per mailbox, where
# <ADDRESS> is the address in capitals with every other character as _ (POS_GMAIL_TOKEN_<ADDRESS> reads,
# POS_GMAIL_COMPOSE_TOKEN_<ADDRESS> makes drafts, POS_GMAIL_SEND_TOKEN_<ADDRESS> sends).
# POS_GOOGLE_CLIENT_ID=
# POS_GOOGLE_CLIENT_SECRET=
# POS_GMAIL_TOKEN_<ADDRESS>=
# POS_GMAIL_COMPOSE_TOKEN_<ADDRESS>=
# POS_GMAIL_SEND_TOKEN_<ADDRESS>=
# Drive tokens: drive.readonly to look, drive.file to create.
# POS_GDRIVE_READ_TOKEN=
# POS_GDRIVE_FILE_TOKEN=
# Invoices: the mailboxes to read (comma separated) and the Drive roots for business and personal ones.
# POS_INVOICE_MAILBOXES=
# POS_INVOICES_BUSINESS_ROOT=
# POS_INVOICES_PERSONAL_ROOT=

# Mail and support (pos.mailfilter, pos.support): a JSON rules file for the mail prefilter; the intake
# (default on, 0 routes mail at once); extra products as JSON.
# POS_MAIL_PREFILTER=
# POS_SUPPORT_INTAKE=
# POS_SUPPORT_PRODUCTS=

# knowlage (pos.knowledge, pos.kb_files): service URLs, workspaces, 1 turns it off.
# POS_KNOWLAGE_URL=
# POS_KNOWLAGE_PUBLIC_URL=
# POS_KNOWLAGE_WORKSPACE=
# POS_KNOWLAGE_FILES_WORKSPACE=
# POS_KNOWLAGE_DISABLED=
# A2A peers (pos.a2a): their URLs, and a key per peer as POS_A2A_KEY_<NAME>.
# POS_KNOWLAGE_A2A_URL=
# POS_NEXUS_A2A_URL=
# POS_NEXUS_URL=
# POS_A2A_KEY_<NAME>=

# Observability (pos.observability, pos.monitor): Grafana (URL, token, health URL, 0 stops the watch),
# Loki, Prometheus and the sentinel's URL.
# POS_GRAFANA_URL=
# POS_GRAFANA_TOKEN=
# POS_GRAFANA_HEALTH_URL=
# POS_GRAFANA_WATCH=
# POS_LOKI_URL=
# POS_LOKI_TENANT=
# POS_PROMETHEUS_URL=
# POS_SENTINEL_URL=
# LiteLLM admin API for model keys (pos.access.litellm); off unless both are set.
# POS_LITELLM_URL=
# POS_LITELLM_ADMIN_KEY=
# Ops runbook socket (pos.ops_runbook).
# POS_OPS_RUNBOOK_SOCKET=
# Sandbox for agent commands (pos.sandbox).
# POS_SANDBOX_URL=
# POS_SANDBOX_TOKEN=
# How long a 1Password value stays in memory, seconds (at most 300).
# POS_OP_CACHE_SECONDS=

# Kniha (pos.scorecard, pos.kniha_reservations): the Kniha checkout and the reservations file.
# POS_KNIHA_DIR=
# POS_KNIHA_RESERVATIONS=
# Home Assistant SSH user when no credential names one (default root).
# POS_HA_SSH_USER=

# Workers and MCP clients (worker/, pos.mcp_server): the agent key, the MCP URL (default POS_URL + /mcp),
# which actor the local MCP server acts as, and the web URL in task links.
# POS_AGENT_KEY=
# POS_MCP_URL=
# POS_MCP_ACTOR=
# POS_WEB_URL=
