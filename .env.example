# Copy to .env and fill in. Leave POS_PASSWORD empty only for local dev (no login).
POS_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POS_SESSION_SECRET=
# Host port for the web UI.
POS_PORT=8080
# Bearer key for MCP clients acting as the owner (Codex / Claude on the laptop).
# Generate with: python -c "import secrets; print('pos_' + secrets.token_urlsafe(32))"
POS_MCP_TOKEN=
# Agent workers (docker compose --profile agents): keys from each agent's page (New key).
DEV_AGENT_KEY=
MAIL_AGENT_KEY=
COMMUNITY_AGENT_KEY=
# Asistent vedení (Chief of Staff); empty: the key the core writes to data/worker-keys/asistent-vedeni.
COS_AGENT_KEY=
# Folder with a logged-in Codex CLI, mounted into the workers (e.g. C:/Users/you/.codex).
CODEX_HOME_HOST=
# Agent runtimes (auto|codex|claude). auto tries POS_ENGINE_ORDER: Codex first, Claude as fallback.
POS_AGENT_RUNTIME=auto
POS_ENGINE_ORDER=codex,claude
# Models: shown on each agent and recorded on every run (the CLI's own report wins).
POS_CODEX_MODEL=gpt-5.6-sol
POS_CLAUDE_MODEL=claude-opus-5-5
POS_CLAUDE_MODEL=claude-opus-5-5
# Claude subscription login for containers: run `claude setup-token` once and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Calendars as private iCal feeds (secret URLs), space separated, optionally Name|url
POS_CALENDAR_ICS=

# Machine clients that may POST /api/events (name:token, comma separated), e.g. knowlage new mail
POS_EVENTS_TOKENS=

# Weekly report and meeting (Asistent vedení, pos.weekly). The time is also editable on Automations.
POS_WEEKLY_REPORT_SCHEDULE=weekly fri 14:00
# Links in chat to the report page (e.g. https://pos.example.com); empty: in-app links.
POS_PUBLIC_URL=
# Commits per repository for the report: a GitHub token that can read the org (also used for outbound GitHub).
POS_GITHUB_TOKEN=
# Which repositories: a list (owner/name, comma separated), else every repo of the org pushed that week.
POS_REPORT_REPOS=
POS_REPORT_GITHUB_ORG=ObseumEU
# Communication counts from knowlage: on when POS_KNOWLAGE_API_KEY is set; 0 turns it off, 1 forces it.
POS_REPORT_KNOWLAGE=
# knowlage service key: a knowlage agent key for PersonalOS (an entry of knowlage's KB_AGENT_KEYS). The
# server uses it for the file push, file search, the agents' `knowledge` tool and the report's invoices;
# it never reaches a model. Without it all of these are off.
POS_KNOWLAGE_API_KEY=
# GitHub triage: new issues and PRs of this organisation's repositories go to the CTO (every 30 min,
# needs POS_GITHUB_TOKEN); default POS_REPORT_GITHUB_ORG, else ObseumEU.
POS_TRIAGE_GITHUB_ORG=

# The sentinel (ops/sentinel, docs/SENTINEL.md): one shared token for its events, heartbeat and log API
# (PersonalOS accepts it as the event sender "sentinel"). Start it with `--profile sentinel`.
POS_SENTINEL_TOKEN=
# Nexus run numbers: a read-only Postgres role (SELECT on runs, workflow_runs, run_events).
SENTINEL_NEXUS_DSN=
# LiteLLM spend vs budgets: a viewer key (never the master key); empty = skipped.
SENTINEL_LITELLM_KEY=
# 1 enables POST /api/test/inject for the end-to-end check; keep 0.
SENTINEL_TEST_HOOK=0
# Caps for the Monitor agent (pos.monitor); above them incidents reach the owner as text.
POS_MONITOR_MAX_INCIDENTS_DAY=12
POS_MONITOR_MAX_RUNS_INCIDENT=2

# Credentials for agents from 1Password (pos.credentials, docs/CREDENTIALS.md): a service account token with
# read access to one vault. Both empty = the feature is off and every credential use fails closed.
OP_SERVICE_ACCOUNT_TOKEN=
POS_OP_VAULT=PersonalOS Agents

# Web Push for the installed app (/m, docs/MOBILE.md): a VAPID key pair (base64url), generated once on the
# server with pos.push.generate_vapid (never printed). Both empty: notifications are off.
POS_VAPID_PRIVATE_KEY=
POS_VAPID_PUBLIC_KEY=
POS_VAPID_SUBJECT=mailto:admin@obseum.cz
