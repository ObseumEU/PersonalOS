# Copy to .env and fill in. Leave POS_PASSWORD empty only for local dev (no login).
POS_PASSWORD=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
POS_SESSION_SECRET=
# Host port for the web UI.
POS_PORT=8080
# Bearer key for MCP clients acting as the owner (Codex / Claude on the laptop).
# Generate with: python -c "import secrets; print('pos_' + secrets.token_urlsafe(32))"
POS_MCP_TOKEN=
# Agent workers (docker compose --profile agents): keys from each agent's page (New key).
DEV_AGENT_KEY=
MAIL_AGENT_KEY=
COMMUNITY_AGENT_KEY=
# Asistent vedení (Chief of Staff); empty: the key the core writes to data/worker-keys/asistent-vedeni.
COS_AGENT_KEY=
# Folder with a logged-in Codex CLI, mounted into the workers (e.g. C:/Users/you/.codex).
CODEX_HOME_HOST=
# Agent runtimes (auto|codex|claude). auto tries POS_ENGINE_ORDER: Codex first, Claude as fallback.
POS_AGENT_RUNTIME=auto
POS_ENGINE_ORDER=codex,claude
# Models: shown on each agent and recorded on every run (the CLI's own report wins).
POS_CODEX_MODEL=gpt-5.6-sol
POS_CLAUDE_MODEL=claude-opus-5-5
POS_CLAUDE_MODEL=claude-opus-5-5
# Claude subscription login for containers: run `claude setup-token` once and paste it here.
CLAUDE_CODE_OAUTH_TOKEN=

# Calendars as private iCal feeds (secret URLs), space separated, optionally Name|url
POS_CALENDAR_ICS=

# Machine clients that may POST /api/events (name:token, comma separated), e.g. knowlage new mail
POS_EVENTS_TOKENS=

# Weekly report and meeting (Asistent vedení, pos.weekly). The time is also editable on Automations.
POS_WEEKLY_REPORT_SCHEDULE=weekly fri 14:00
# Links in chat to the report page (e.g. https://pos.example.com); empty: in-app links.
POS_PUBLIC_URL=
# Commits per repository for the report: a GitHub token that can read the org (also used for outbound GitHub).
POS_GITHUB_TOKEN=
# Which repositories: a list (owner/name, comma separated), else every repo of the org pushed that week.
POS_REPORT_REPOS=
POS_REPORT_GITHUB_ORG=ObseumEU
# Communication counts from knowlage: on when POS_KNOWLAGE_API_KEY is set; 0 turns it off, 1 forces it.
POS_REPORT_KNOWLAGE=
