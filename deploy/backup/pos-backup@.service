[Unit]
Description=PersonalOS host backup: %i (T-379)
Documentation=file:///opt/PersonalOS/deploy/backup/README.md
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pos-backup/pos-backup.sh %i
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=2h
