# TCP MSS clamping for traffic forwarded into/out of the WireGuard tunnel (wg0, MTU 1420).
# Applied on the hub 2026-09-30 and persisted in /etc/iptables/rules.v4 (netfilter-persistent save).
# Re-apply by hand (idempotent):
#   for d in "-o wg0" "-i wg0"; do iptables -t mangle -C FORWARD $d -p tcp --tcp-flags SYN,RST SYN \
#     -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || iptables -t mangle -A FORWARD $d -p tcp \
#     --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu; done; netfilter-persistent save
*mangle
-A FORWARD -o wg0 -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
-A FORWARD -i wg0 -p tcp -m tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
COMMIT
