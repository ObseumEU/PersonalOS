# Site block for the host's front proxy (/opt/server/docker-migration/caddy/Caddyfile),
# next to the knowlage block and with the same access rule: the LAN and the VPN
# only (10.66.66.1 is the VPN gateway itself, which knowlage denies too), 403 for
# everything else. Validate before reloading:
#   docker exec <caddy> caddy validate --config /etc/caddy/Caddyfile
http://personalos.obseum.cz {
	@private {
		remote_ip 192.168.0.0/16 10.66.66.0/24
		not remote_ip 10.66.66.1
	}
	handle @private {
		reverse_proxy personalos:80 {
			flush_interval -1
		}
	}
	respond 403
}
