      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P148A5550C732AD4B"
          },
          "expr": "{host=\"svr03\", stack=\"litellm\", level=~\"error|warn\"}",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
