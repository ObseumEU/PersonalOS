  "panels": [
    {
      "id": 21,
      "type": "timeseries",
      "title": "Error log lines by service (per 5 min)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "loki",
        "uid": "P148A5550C732AD4B"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P148A5550C732AD4B"
          },
          "expr": "sum by (stack, service) (count_over_time({host=\"svr03\", stack=~\"$stack\", level=\"error\"} [5m]))",
          "refId": "A",
          "legendFormat": "{{stack}}/{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
