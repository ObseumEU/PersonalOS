      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "container:cpu_cores:rate5m{host=\"svr03\", stack=~\"$stack\"}",
          "refId": "A",
          "legendFormat": "{{container}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
