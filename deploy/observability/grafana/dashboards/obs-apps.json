      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 28,
      "type": "logs",
      "title": "Log explorer (stack, level and text from the variables above)",
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 24,
        "h": 16
      },
      "datasource": {
        "type": "loki",
        "uid": "P148A5550C732AD4B"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "P148A5550C732AD4B"
          },
          "expr": "{host=\"svr03\", stack=~\"$stack\", level=~\"$level\"} |~ \"(?i)$search\"",
          "refId": "A",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none"
      }
    }
