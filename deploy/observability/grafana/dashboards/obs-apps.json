        }
      }
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Health checks",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "probe_success{app=~\"personalos|knowlage|nexus-api|nexus-web|litellm|langfuse\"}",
          "refId": "A",
          "legendFormat": "{{app}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "max": 1,
          "min": 0,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "stacking": {
              "mode": "none"
            },
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 25,
      "type": "table",
      "title": "Nexus runs (last hour)",
      "gridPos": {
        "x": 18,
        "y": 8,
        "w": 6,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "label_replace(nexus_runs_failed, \"kind\", \"agent runs failed\", \"\", \"\") or label_replace(nexus_runs_finished, \"kind\", \"agent runs finished\", \"\", \"\") or label_replace(nexus_workflow_runs_failed, \"kind\", \"workflows failed\", \"\", \"\")",
          "refId": "A",
          "legendFormat": "",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {},
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "container_id": true
            }
          }
        }
      ]
    },
    {
      "id": 26,
      "type": "timeseries",
      "title": "Memory of the app containers",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "obs-prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "obs-prometheus"
          },
          "expr": "container:memory_working_set_bytes{host=\"svr03\", stack=~\"$stack\"}",
          "refId": "A",
          "legendFormat": "{{container}}",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
